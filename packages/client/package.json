{
  "name": "@leaderlib/client",
  "version": "0.1.3",
  "type": "module",
  "description": "High-level client SDK for LeaderLib leaderboards",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@bsv/sdk": "^1.6.20",
    "@leaderlib/core": "0.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
