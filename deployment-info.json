{
  "schema": "bsv-app",
  "schemaVersion": "1.0",
  "topicManagers": {
    "tm_leaderlib": "./backend/src/topic-managers/LeaderLibTopicManager.ts"
  },
  "lookupServices": {
    "ls_leaderlib": {
      "serviceFactory": "./backend/src/lookup-services/LeaderLibLookupServiceFactory.ts",
      "hydrateWith": "mongo"
    }
  },
  "frontend": {
    "language": "react",
    "sourceDirectory": "./frontend"
  },
  "configs": [
    {
      "name": "Local LARS",
      "network": "mainnet",
