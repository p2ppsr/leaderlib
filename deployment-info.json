      "run": [
        "backend",
        "frontend"
      ]
    },
    {
      "name": "LeaderLib",
      "provider": "CARS",
      "CARSCloudURL": "https://cars.babbage.systems",
      "projectID": "290dd3bea7a1f0af417442315e4f3e83",
      "network": "mainnet",
      "deploy": [
        "frontend",
        "backend"
      ],
      "frontendHostingMethod": "HTTPS"
    }
  ]
}